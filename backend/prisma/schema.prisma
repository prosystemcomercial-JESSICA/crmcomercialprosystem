  senha                String    @db.VarChar(255) // 255 p/ caber hash bcrypt (60 chars)
  cargo                String    @db.VarChar(50)
  classificacao        String?   @db.VarChar(5)
  status               String?   @default("ATIVO") @db.VarChar(20)
  observacoes          String?   @db.Text
  modulos_permissao    Json?
  precisa_trocar_senha Boolean?  @default(false) // força troca no 1º acesso / após reset
  created_by           String?   @db.VarChar(255)
  created_at           DateTime? @default(now())
  updated_at           DateTime? @default(now())
}

model AuditoriaUsuario {
  id         String    @id @db.Char(36)
  ator_id    String?   @db.VarChar(255)
  ator_nome  String?   @db.VarChar(255)
  ator_role  String?   @db.VarChar(50)
  acao       String?   @db.VarChar(100)
  alvo_id    String?   @db.VarChar(255)
  alvo_nome  String?   @db.VarChar(255)
  detalhes   Json?
  created_at DateTime? @default(now())
}

model FunilEtapa {
  id               String    @id @db.Char(36)
  codigo           String    @unique @db.VarChar(50)
  nome             String    @db.VarChar(100)
  cor              String?   @default("#6b7280") @db.VarChar(20)
  ordem            Int?      @default(99)
  tipo             String?   @default("ANDAMENTO") @db.VarChar(20)
  conta_pipeline   Boolean?  @default(true)
  visivel_vendedor Boolean?  @default(true)
  ativa            Boolean?  @default(true)
  fixo             Boolean?  @default(false)
  created_at       DateTime? @default(now())
  updated_at       DateTime? @default(now())
}

model LeadPerda {
  id                 String    @id @db.Char(36)
  lead_id            String    @db.VarChar(255)
  lead_nome          String?   @db.VarChar(255)
  etapa_anterior     String?   @db.VarChar(50)
  etapa_destino      String?   @db.VarChar(50)
  motivo             String?   @db.VarChar(100)
  motivo_outro       String?   @db.Text
  observacoes        String?   @db.Text
  valor_oportunidade Decimal?  @db.Decimal(12, 2)
  vendedor_id        String?   @db.VarChar(255)
  vendedor_nome      String?   @db.VarChar(255)
  created_at         DateTime? @default(now())
}

model LeadHistorico {
  id             String    @id @db.Char(36)
  lead_id        String    @db.VarChar(255)
  lead_nome      String?   @db.VarChar(255)
  acao           String?   @db.VarChar(100)
  etapa_anterior String?   @db.VarChar(50)
  etapa_destino  String?   @db.VarChar(50)
  ator_id        String?   @db.VarChar(255)
  ator_nome      String?   @db.VarChar(255)
  detalhes       Json?
  created_at     DateTime? @default(now())
}

model MetaVendedor {
  id            String    @id @db.Char(36)
  vendedor_id   String    @db.VarChar(255)
  vendedor_nome String?   @db.VarChar(255)
  ano           Int
  mes           Int?
  trimestre     Int?
  meta_valor    Decimal   @db.Decimal(12, 2)
  bonus_valor   Decimal?  @db.Decimal(12, 2)
  created_at    DateTime? @default(now())

  @@unique([vendedor_id, ano, mes, trimestre], name: "uq_meta")
