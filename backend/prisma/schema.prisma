  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  plano_id String?
  plano    PlanoServico? @relation(fields: [plano_id], references: [id], onDelete: SetNull)

  status      String    @default("ATIVA") // ATIVA|SUSPENSA|EXPIRADA|CANCELADA
  data_inicio DateTime
  data_fim    DateTime?
  valor       Float
  chave       String? // license key

  responsavel_id String?
  observacoes    String? @db.Text

