model Renovacao {
  id         String  @id @default(cuid())
  licenca_id String
  licenca    Licenca @relation(fields: [licenca_id], references: [id], onDelete: Cascade)

  status          String   @default("PENDENTE") // PENDENTE|EM_NEGOCIACAO|RENOVADA|CANCELADA|PERDIDA
  data_vencimento DateTime
  valor_atual     Float
  valor_novo      Float?

  responsavel_id String?
  observacoes    String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([licenca_id])
  @@index([status])
  @@index([data_vencimento])
}

model TicketSuporte {
  id         String  @id @default(cuid())
  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  licenca_id String?
  licenca    Licenca? @relation(fields: [licenca_id], references: [id], onDelete: SetNull)

  titulo     String
  descricao  String? @db.Text
  categoria  String  @default("TECNICO") // TECNICO|FISCAL|COMERCIAL|FINANCEIRO|TREINAMENTO
  prioridade String  @default("MEDIA") // BAIXA|MEDIA|ALTA|CRITICA
  status     String  @default("ABERTO") // ABERTO|EM_ATENDIMENTO|AGUARDANDO_CLIENTE|RESOLVIDO|FECHADO

  responsavel_id String?
  sla_horas      Int?
  resolucao_at   DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id])
  @@index([status])
  @@index([prioridade])
  @@index([created_at])
}

// ===== COMISSÕES E INDICAÇÕES =====

model RegraComissao {
  id             String  @id @default(cuid())
  nome           String
  responsavel_id String
  tipo           String  @default("CONTRATO") // CONTRATO|PROPOSTA|LEAD
  percentual     Float // ex: 5.0 = 5%
  ativo          Boolean @default(true)
  observacoes    String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  comissoes Comissao[]

  @@index([responsavel_id])
  @@index([ativo])
}

model Comissao {
  id             String         @id @default(cuid())
  responsavel_id String
  regra_id       String?
  regra          RegraComissao? @relation(fields: [regra_id], references: [id], onDelete: SetNull)

  tipo          String // CONTRATO|PROPOSTA|LEAD|MANUAL|BONUS
  referencia_id String? // ID do contrato/proposta/lead
  descricao     String? @db.Text

  valor_base     Float
  percentual     Float
  valor_comissao Float

  periodo String // "YYYY-MM" (competência da venda)
  status  String @default("PENDENTE") // PENDENTE|APROVADA|PAGA|CANCELADA

  // Fluxo de pagamento da comissão (vendedor e supervisão):
  //  A_RECEBER  → contrato assinado, sem data de instalação (expectativa, sem mês)
  //  A_CONFIRMAR→ instalado, aguardando supervisão confirmar 1º vencimento
  //  CONFIRMADA → mês de pagamento definido (1º vencimento + 1 mês), pronto p/ financeiro
  //  PAGA       → financeiro quitou
  estagio        String    @default("A_RECEBER")
  papel          String? // VENDEDOR | SUPERVISAO
  mes_pagamento  String? // "YYYY-MM" — mês em que o financeiro paga a comissão
  implantacao_id String?
  aprovada_por   String?
  aprovada_em    DateTime?
  paga_em        DateTime?

  created_by String   @default("system")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([responsavel_id])
  @@index([periodo])
  @@index([status])
  @@index([estagio])
  @@index([mes_pagamento])
}

// Acompanhamento da implantação do sistema no cliente (nasce do contrato assinado).
// Supervisão informa a data de instalação e o 1º vencimento → libera a comissão.
model Implantacao {
  id          String  @id @default(cuid())
  contrato_id String  @unique
  proposta_id String?
  lead_id     String?

  cliente_razao_social String
  cliente_cnpj         String?
  plano                String?
  vendedor_id          String?
  vendedor_nome        String?
  valor_setup          Float?
  mensalidade          Float?

  status                   String    @default("AGUARDANDO_INSTALACAO")
  // AGUARDANDO_INSTALACAO | AGENDADA | INSTALADO | CANCELADA
  data_assinatura          DateTime?
  data_agendada            DateTime?
  data_instalacao          DateTime?
  data_primeiro_vencimento DateTime?
  mes_pagamento_comissao   String? // "YYYY-MM" = mês do 1º vencimento + 1
  observacoes              String?   @db.Text

  // Tipo da base (vem da proposta): banco zerado (nova instalação) ou conversão.
  tipo_base        String? // BANCO_ZERADO | CONVERSAO
  sistema_anterior String? // se CONVERSAO: de qual sistema vem

  // ─── Execução técnica da implantação ───────────────────────────
  tecnico_id     String? // técnico de implantação designado
  tecnico_nome   String?
  designado_em   DateTime?
  // Etapa da execução técnica (kanban do técnico)
  etapa_execucao String    @default("AGUARDANDO_DESIGNACAO")
  // AGUARDANDO_DESIGNACAO | DESIGNADO | EM_ANALISE | EM_CONVERSAO | EM_CONFIGURACAO | EM_TREINAMENTO | FINALIZADO

  // ─── Trilha de tempo por fase ───────────────────────────────────
  data_entrada_lead  DateTime? // entrada do lead (negociação)
  // assinatura → data_assinatura | instalação → data_instalacao
  treinamento_inicio DateTime?
  treinamento_fim    DateTime?
  data_conclusao     DateTime? // implantação concluída (fim do ciclo)

  // Prazos-meta para nortear o técnico (default: +15 virada / +30 finalização da assinatura)
  prazo_virada      DateTime?
  prazo_finalizacao DateTime?

  created_by String   @default("system")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  atividades ImplantacaoAtividade[]
  testes     ImplantacaoTeste[]
  arquivos   ImplantacaoArquivo[]
  checklist  ImplantacaoChecklistItem[]

  @@index([status])
  @@index([etapa_execucao])
  @@index([tecnico_id])
  @@index([vendedor_id])
  @@index([mes_pagamento_comissao])
}

// Linha do tempo da implantação (o que o técnico/supervisão fez e quando).
model ImplantacaoAtividade {
  id             String      @id @default(cuid())
  implantacao_id String
  implantacao    Implantacao @relation(fields: [implantacao_id], references: [id], onDelete: Cascade)
  tipo           String      @default("NOTA") // NOTA | MUDANCA_ETAPA | DESIGNACAO | TESTE | ARQUIVO | TREINAMENTO
  descricao      String      @db.Text
