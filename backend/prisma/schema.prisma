// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== USUARIOS =====
model Usuario {
  id    String  @id @default(cuid())
  nome  String
  email String  @unique
  role  String // VENDEDOR|SUPERVISAO|CEO|ADMIN|FINANCEIRO|TECNICO
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([role])
  @@index([email])
}

// ===== CLIENTES =====
model Cliente {
  id       String  @id @default(cuid())
  nome     String
  email    String?  // opcional: a base importada nem sempre tem e-mail (unique removido p/ migracao nao-destrutiva)
  telefone String?
  empresa  String?
  cidade   String?
  estado   String?

  // ── Identificação / base de clientes (importação + gestão) ──
  codigo        String?  // código do cliente no sistema legado (chave de upsert; unicidade garantida na lógica de importação)
  razao_social  String?
  nome_fantasia String?
  cnpj          String?
  situacao      String?  @default("ATIVA")  // ATIVA|INATIVA
  motivo_inativacao String? @db.Text         // motivo detalhado da desativação
  inativado_em      DateTime?                 // quando foi desativado
  mrr_perdido       Float?                    // mensalidade perdida na desativação (churn)
  valor_devido_inativacao Float?              // valor que o cliente ficou devendo ao sair
  sistema_removido_em     DateTime?           // quando o sistema foi de fato desligado (evento técnico, pós-PERDIDO)
  segmento      String?                       // Farmácia|Padaria|Varejo|...
  grupo_tecnico String?                       // grupo de atendimento técnico
  plano         String?                       // BASIC|MEI|PRO|PLUS|...
  contato       String?                       // nome do contato principal
  data_entrada  DateTime?                     // desde quando é cliente (tempo de casa)
  observacoes   String?  @db.Text             // atualizações / anotações manuais

  // ── Campanha de ativos (upsell na base) — perguntas respondíveis ──
  apresentou_plus       Boolean? @default(false) // Plus + novas ferramentas apresentado?
  conhece_dashboard     Boolean? @default(false)
  conhece_mensageria    Boolean? @default(false)
  conhece_gerencial     Boolean? @default(false)
  conhece_atencao_farma Boolean? @default(false)
  risco_atencao         Boolean? @default(false) // cliente em risco / precisa de atenção
  ativo_observacoes     String?  @db.Text        // notas da campanha de ativos

  // Mensalidade base (importada do cadastro original). A mensalidade TOTAL =
  // base + soma dos acréscimos de vendas adicionais CONFIRMADAS (ex.: Arquivo Fiscal).
  mensalidade_base Float?
  observacoes_fin  String? @db.Text // observações financeiras (ajustes/radar)

  // ── Dados cadastrais complementares (planilha legada) ───────────────────────
  // Endereço completo
  cep            String?
  endereco       String?
  numero_end     String?  // número (pode ser "SN", "S/N")
  complemento    String?
  bairro         String?
  codigo_ibge    String?  // código IBGE do município
  // Contato / telefones
  ddd            String?
  telefone1      String?
  telefone2      String?
  tel_contato    String?
  contato2       String?
  tel_contato2   String?
  contato_pesquisa String?
  // Fiscais / responsável
  inscricao_estadual String?
  cpf_responsavel    String?
  rg_responsavel     String?
  responsavel_nome   String?  // responsável legal do cadastro
  regime_tributario  String?  // Simples | Presumido | Real
  // Comerciais / financeiros
  dia_vencimento     Int?     // dia do vencimento da mensalidade
  vencimento_licenca DateTime?
  reajuste_em        DateTime?
  ultimo_pagamento   DateTime?
  previsao_pagamento String?  // texto livre (pode vir "- -")
  regiao             String?
  valor_instalacao   Float?
  condicao_pagamento String? @db.Text
  data_cadastro      DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  caso_churn        CasoChurn[]
  survey_churn      SurveyChurn[]
  creditos          Credito[]
  campanhas_disparo CampanhaDisparo[]
  licencas          Licenca[]
  tickets           TicketSuporte[]
  indicacoes_feitas Indicacao[]       @relation("IndicacoesFeitas")
  health_score      HealthScore?
  vendas_adicionais VendaAdicional[]
  historico_cnpj    HistoricoCnpjCliente[]
  eventos           EventoCliente[]
  contatos          ContatoCliente[]
  documentos        ClienteDocumento[]

  @@index([email])
  @@index([empresa])
  @@index([codigo])
  @@index([situacao])
  @@index([grupo_tecnico])
  @@index([segmento])
}

// ===== DOCUMENTOS DO CLIENTE =====
// Arquivos (PDF, imagens, docs) vinculados a um cliente. Armazenados como base64
// para não depender de storage externo. Limite por arquivo: ~5MB (prático para PDFs de contrato).
model ClienteDocumento {
  id         String  @id @default(cuid())
  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  nome       String      @db.VarChar(255)   // nome original do arquivo
  tipo       String      @default("OUTRO")  // CONTRATO | COMPROVANTE | IDENTIDADE | NOTA_FISCAL | OUTRO
  mime_type  String      @db.VarChar(100)   // application/pdf | image/jpeg | image/png | etc.
  tamanho    Int                            // tamanho em bytes
  conteudo   Bytes       @db.MediumBlob     // conteúdo binário do arquivo (até ~16MB)
  descricao  String?     @db.Text

  enviado_por      String?
  enviado_por_nome String?
  created_at       DateTime @default(now())

  @@index([cliente_id])
  @@index([tipo])
}

// Histórico de TROCAS DE CNPJ do cliente. Quando a empresa troca de CNPJ mas
// mantém o mesmo código no nosso sistema, registramos um snapshot dos dados
// ANTIGOS aqui e atualizamos o cadastro com os novos. Nada se perde.
model HistoricoCnpjCliente {
  id        String  @id @default(cuid())
  cliente_id String
  cliente   Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  // Snapshot dos dados ANTIGOS (antes da troca)
  cnpj_anterior          String?
  razao_social_anterior  String?
  nome_fantasia_anterior  String?
  inscricao_anterior     String?
  // Novos dados (para conferência rápida)
  cnpj_novo          String?
  razao_social_nova  String?
  nome_fantasia_nova String?

  motivo     String?  @db.Text
  trocado_por      String?
  trocado_por_nome String?
  created_at DateTime @default(now())

  @@index([cliente_id])
}

// Contatos da empresa cliente (pessoas: dono, gerente, financeiro...). Era uma
// tabela raw que nunca foi criada → agora é model de verdade, com CARGO.
model ContatoCliente {
  id         String  @id @default(cuid())
  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  nome       String
  telefone   String?
  cargo      String?  // ex.: Proprietário, Gerente, Financeiro, Comprador
  email      String?
  origem     String?  // MANUAL | WHATSAPP (de onde veio o contato)
  principal  Boolean  @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id])
}

// TIMELINE de monitoramento do cliente: registra TODA ação associada à base
// (solicitação de serviço, registro de churn, renegociação, troca de CNPJ,
// desativação/reativação, ajuste de mensalidade...) num feed único e auditável.
model EventoCliente {
  id        String  @id @default(cuid())
  cliente_id String
  cliente   Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  tipo        String   // SERVICO | CHURN | RENEGOCIACAO | TROCA_CNPJ | DESATIVACAO | REATIVACAO | MENSALIDADE | OBSERVACAO | OUTRO
  titulo      String
  descricao   String?  @db.Text
  referencia_id String?  // id do registro relacionado (caso, solicitação, etc.)
  metadados   Json?     // dados extras (valores, antes/depois)

  feito_por      String?
  feito_por_nome String?
  created_at DateTime @default(now())

  @@index([cliente_id])
  @@index([tipo])
  @@index([created_at])
}

// ===== SPRINT 28: CHURN E RETENCAO =====

model CasoChurn {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  status           String  @default("NOVO") // NOVO|DIAGNOSTICADO|PLANEJADO|EXECUTANDO|RECUPERADO|PERDIDO|SISTEMA_REMOVIDO
  risk_score       Float   @default(0)
  motivo_principal String? @db.Text
  descricao        String? @db.Text // observações/contexto do problema ao abrir o caso

  // Caso retroativo: quando o problema começou ANTES do cadastro no CRM.
  // created_at continua sendo "quando foi cadastrado" (auditoria); data_abertura_real
  // é usada pra contar os "dias em aberto" quando informada.
  retroativo         Boolean   @default(false)
  data_abertura_real DateTime?

  // ── Situação financeira do cliente (aditivo) ────────────────────────────────
  fin_situacao     String?  // EM_DIA | EM_ATRASO | NEGOCIANDO | INADIMPLENTE
  fin_valor_atraso Float?   // quanto está em atraso (quando EM_ATRASO/INADIMPLENTE)
  fin_dias_atraso  Int?     // há quantos dias em atraso
  fin_observacao   String?  @db.Text // detalhes financeiros (boletos, parcelas, etc.)

  // ── Renegociação por dificuldade financeira (aditivo) ───────────────────────
  // Preenchido quando o caso vira uma renegociação de débito. Os campos de
  // parcelamento só são exigidos/mostrados no front quando reneg_ativa = true.
  reneg_ativa           Boolean   @default(false)
  reneg_como_mantido    String?   @db.Text // o que foi feito p/ manter o cliente
  reneg_resultado       String?   @db.Text // como ficou após a renegociação
  reneg_valor_devido    Float?    // total devido antes do acordo
  reneg_valor_entrada   Float?    // entrada paga no ato do acordo
  reneg_parcelas        Int?      // nº de parcelas restantes (1 a 6)
  reneg_responsavel     String?   // nome completo do responsável que assina
  reneg_responsavel_cpf String?   // CPF do responsável
  reneg_data            DateTime? // data do acordo
  reneg_proximo_vencimento DateTime? // data do próximo vencimento acordado

  // ── Resolução e reabertura (aditivo) ────────────────────────────────────────
  // resolvido_em = 1ª vez que o caso virou RECUPERADO ou PERDIDO (idempotente).
  // Reabertura é permitida SÓ UMA VEZ, e só a partir de RECUPERADO — trava o
  // motivo original (reaberto_motivo_travado) pra garantir que é o mesmo problema.
  resolvido_em             DateTime? // 1ª resolução (RECUPERADO ou PERDIDO)
  reaberto                 Boolean   @default(false) // liga permanentemente, nunca desliga
  reaberto_em              DateTime? // quando a reabertura aconteceu
  reaberto_motivo_travado  String?   // snapshot do motivo_principal original
  resolvido_em_2           DateTime? // 2ª resolução (pós-reabertura)

  // Evento técnico posterior a PERDIDO: quando o sistema foi de fato desligado
  // (pode levar dias/semanas após a perda comercial). Só permitido a partir de
  // PERDIDO; idempotente (não sobrescreve).
  sistema_removido_em      DateTime?

  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  diagnosis    DiagnosisChurn?
  survey_churn SurveyChurn?
  planos       PlanoRetencao[]
  acoes        AcaoRetencao[]
  atualizacoes AtualizacaoCaso[]

  @@index([status])
  @@index([clienteId])
  @@index([risk_score])
  @@index([created_at])
}

// Linha do tempo do caso de churn: cada atualização (observação, contato,
// tentativa, nota financeira, mudança de status) vira um registro. É o "como
// está sendo tratado" — quem fez, quando e o quê.
model AtualizacaoCaso {
  id            String    @id @default(cuid())
  caso_churn_id String
  caso_churn    CasoChurn @relation(fields: [caso_churn_id], references: [id], onDelete: Cascade)

  tipo      String  // OBSERVACAO | CONTATO | TENTATIVA | FINANCEIRO | STATUS | SISTEMA
  texto     String  @db.Text
  // Para CONTATO/TENTATIVA: como foi o contato e o resultado.
  canal     String? // TELEFONE | WHATSAPP | EMAIL | PRESENCIAL | OUTRO
  resultado String? // ATENDEU | NAO_ATENDEU | RETORNARA | SEM_RESPOSTA | RESOLVIDO

  feito_por      String?
  feito_por_nome String?
  created_at DateTime @default(now())

  @@index([caso_churn_id])
  @@index([created_at])
}

model DiagnosisChurn {
  id            String    @id @default(cuid())
  caso_churn_id String    @unique
  caso_churn    CasoChurn @relation(fields: [caso_churn_id], references: [id], onDelete: Cascade)

  motivo_principal String @db.Text
  risco_score      Float
  fatores          Json // Array de fatores de risco

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([caso_churn_id])
}

model PlanoRetencao {
  id            String    @id @default(cuid())
  caso_churn_id String
  caso_churn    CasoChurn @relation(fields: [caso_churn_id], references: [id], onDelete: Cascade)

  titulo    String
  descricao String? @db.Text
  status    String  @default("RASCUNHO") // RASCUNHO|ATIVO|CONCLUIDO

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  acoes AcaoRetencao[]

  @@index([caso_churn_id])
}

model AcaoRetencao {
  id            String    @id @default(cuid())
  caso_churn_id String
  caso_churn    CasoChurn @relation(fields: [caso_churn_id], references: [id], onDelete: Cascade)

  plano_id String?
  plano    PlanoRetencao? @relation(fields: [plano_id], references: [id], onDelete: SetNull)

  titulo          String
  descricao       String? @db.Text
  tipo            String // CONTATO|EMAIL|DESCONTO|PRODUTO|OUTRO
  status          String    @default("NOVA") // NOVA|EM_PROGRESSO|CONCLUIDA|CANCELADA
  responsavel_id  String?
  data_vencimento DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([caso_churn_id])
  @@index([plano_id])
}

model HistoricoLead {
  id             String  @id @default(cuid())
  tipo           String // caso_criado|status_alterado|acao_criada|survey_respondido|etc
  descricao      String @db.Text
  relacionado_id String? // ID do caso/survey/acao relacionada

  created_by String
  created_at DateTime @default(now())

  @@index([relacionado_id])
  @@index([tipo])
}

// ===== SPRINT 29: PESQUISA DE MOTIVOS =====

model SurveyChurn {
  id          String    @id @default(cuid())
  casoChurnId String    @unique
  caso_churn  CasoChurn @relation(fields: [casoChurnId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  status String @default("PENDING") // PENDING|OPENED|RESPONDED|EXPIRED

  email_enviado Boolean   @default(false)
  enviado_em    DateTime?
  email_aberto  Boolean   @default(false)

  respondida    Boolean   @default(false)
  respondido_em DateTime?

  expira_em DateTime // 30 days from creation

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  resposta SurveyResposta?

  @@index([status])
  @@index([respondida])
  @@index([expira_em])
}

model SurveyResposta {
  id           String      @id @default(cuid())
  surveyId     String      @unique
  survey_churn SurveyChurn @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  q1_resposta String  @db.Text
  q2_resposta String? @db.Text
  q3_score    Int // 1-10
  q4_opcao    String // sim|nao|talvez
  q5_stars    Int // 1-5

  sentimento_q1       Float? // -1.0 to +1.0
  sentimento_q1_label String?
  sentimento_q1_conf  Int? // 0-100

  sentimento_q2       Float?
  sentimento_q2_label String?
  sentimento_q2_conf  Int?

  keywords_q1 Json // JSON array
  keywords_q2 Json

  motivo_real      String? // Enum 10 categorias
  confianca        String? // HIGH|MEDIUM|LOW|NONE
  manual_corrected Boolean @default(false)

  ip_address   String?
  responded_at DateTime @default(now())

  @@index([sentimento_q1])
  @@index([motivo_real])
}

// ===== SPRINT 30: CAMPANHAS =====

model Campanha {
  id        String  @id @default(cuid())
  nome      String  @db.VarChar(100)
  descricao String? @db.Text

  status      String   @default("RASCUNHO") // RASCUNHO|ATIVA|PAUSADA|FINALIZADA|ARQUIVADA
  data_inicio DateTime
  data_fim    DateTime

  nicho             String? @db.VarChar(100)
  plano_alvo        String? @db.VarChar(80)
  mensalidade       Float?
  valor_setup       Float?
  setup_condicao    String? @db.VarChar(200)
  condicao_especial String? @db.VarChar(500)
  meta_contratos    Int?
  meta_receita      Float?

  created_by String
  created_at DateTime @default(now())
  updated_by String?
  updated_at DateTime @updatedAt

  acoes     CampanhaAcao[]
  disparos  CampanhaDisparo[]
  auditoria AuditoriaCompanha[]

  @@index([status])
  @@index([created_by])
  @@index([data_inicio])
}

model CampanhaAcao {
  id          String   @id @default(cuid())
  campanha_id String
  campanha    Campanha @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  tipo_trigger String // IMEDIATO|HORARIO|WEBHOOK
  tipo_acao    String // ENVIAR_EMAIL|ENVIAR_SMS|CRIAR_TASK|APLICAR_CREDITO|WEBHOOK
  configuracao Json // {template_id, cron, webhook_url, etc}

  ordem        Int // sequência de execução
  atraso_horas Int @default(0)

  status           String    @default("CRIADA") // CRIADA|AGENDADA|EXECUTANDO|COMPLETA|ERRO
  ultima_execucao  DateTime?
  proxima_execucao DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  disparos CampanhaDisparo[]

  @@unique([campanha_id, ordem])
  @@index([campanha_id])
}

model CampanhaDisparo {
  id          String   @id @default(cuid())
  campanha_id String
  campanha    Campanha @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  acao_id String?
  acao    CampanhaAcao? @relation(fields: [acao_id], references: [id], onDelete: SetNull)

  tipo       String // EMAIL|SMS|TASK|WEBHOOK
  status     String // ENVIADO|ERRO|BOUNCE|COMPLAINED|DELIVERED|ABERTO
  message_id String?

  sent_at      DateTime?
  delivered_at DateTime?
  bounced_at   DateTime?

  email_aberto Boolean   @default(false)
  opened_at    DateTime?

  link_clicado Boolean   @default(false)
  clicked_at   DateTime?

  metadados Json?

  created_at DateTime @default(now())

  @@index([campanha_id])
  @@index([cliente_id])
  @@index([status])
}

model Template {
  id      String @id @default(cuid())
  nome    String @db.VarChar(100)
  assunto String @db.VarChar(200)
  corpo   String @db.Text // HTML

  variaveis_tag  Json
  tags_indicadas Json // [PRECO, SUPORTE]

  versao Int     @default(1)
  ativa  Boolean @default(true)

  created_by String
  created_at DateTime @default(now())
  updated_by String?
  updated_at DateTime @updatedAt

  @@index([created_by])
}

model AuditoriaCompanha {
  id          String   @id @default(cuid())
  campanha_id String
  campanha    Campanha @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  usuario_id String
  acao       String // CREATE|UPDATE|ATIVA|PAUSADA|FINALIZADA

  dados_antes  Json?
  dados_depois Json?
  ip_address   String?

  timestamp DateTime @default(now())

  @@index([campanha_id])
  @@index([usuario_id])
}

// ===== MODULO COMERCIAL =====

model Lead {
  id String @id @default(cuid())

  // Dados da empresa
  nome              String // nome do lead / razão social resumida
  razao_social      String?
  nome_fantasia     String?
  cnpj              String?
  empresa           String? // alias legado de razao_social
  segmento          String?
  cidade            String?
  estado            String?
  endereco          String?
  tipo_negocio      String?
  qtd_lojas         Int?
  qtd_caixas        Int?
  sistema_atual     String?
  tipo_oportunidade String? // NOVA_IMPLANTACAO|MIGRACAO|UPGRADE|REATIVACAO|VENDA_ADICIONAL|FILIAL

  // Responsável
  responsavel_nome     String?
  responsavel_cargo    String? // alias cargo
  cargo                String? // legado
  responsavel_telefone String?
  responsavel_email    String?
  email                String? // legado
  telefone             String? // legado
  responsavel_cpf      String?
  responsavel_horario  String?

  // Dados comerciais do lead
  vendedor_nome          String?
  vendedor_telefone      String?
  supervisor_nome        String?
  campanha               String?
  plano_indicado         String?
  plano_interesse        String?
  valor_setup            Float?
  valor_conversao        Float?
  mensalidade_estimada   Float?
  entrada                Float?
  parcelamento           Int?
  validade_proposta      DateTime?
  observacoes_comerciais String?   @db.Text
  condicao_especial      String? @db.Text

  // Dados para proposta (pré-preenchimento)
  frase_hero          String? @db.Text
  texto_valor         String? @db.Text
  segmento_proposta   String?
  plano_recomendado   String?
  modulos_inclusos    Json    @default("[]")
  servicos_adicionais Json    @default("[]")

  // Pipeline / Kanban comercial
  etapa_comercial    String @default("NOVO_LEAD")
  status_atendimento String @default("NOVO")
  // NOVO|SEM_CONTATO|CONTATO_TENTADO|EM_CONVERSA|QUALIFICADO|AGUARDANDO_RETORNO
  // |PROPOSTA_NECESSARIA|PROPOSTA_ENVIADA|EM_NEGOCIACAO|ACEITO|FECHADO|PERDIDO

  origem         String  @default("MANUAL")
  status         String  @default("NOVO")
  etapa_funil    String  @default("PROSPECCAO")
  temperatura    String  @default("FRIO") // FRIO|MORNO|QUENTE|MUITO_QUENTE
  valor_estimado Float?
  probabilidade  Int?
  motivo_perda   String? @db.Text

  // UTM / Campanha tracking
  utm_source    String?
  utm_medium    String?
  utm_campaign  String?
  utm_content   String?
  utm_term      String?
  fbclid        String?
  gclid         String?
  campaign_id   String?
  adset_id      String?
  ad_id         String?
  campanha_nome String?
  conjunto_nome String?
  anuncio_nome  String?
  plataforma    String?
  link_origem   String?

  proximo_contato DateTime?
  ultima_obs_at   DateTime?

  responsavel_id String?
  observacoes    String? @db.Text

  // Atribuição ao vendedor (supervisão atribui → vira alerta no sininho do vendedor)
  atribuido_em     DateTime?
  atribuicao_vista Boolean   @default(true)

  // ─── Dados de fechamento (preenchidos ao mover para ACEITO) ──
  fechamento_plano         String? // 'BASIC' | 'MEI' | 'PRO' | 'PLUS'
  fechamento_valor_inst    Float? // valor único de instalação
  fechamento_mrr           Float? // mensalidade recorrente (MRR)
  fechamento_valor_entrada Float? // valor da entrada
  fechamento_forma_entrada String? // 'PIX' | 'BOLETO' | 'CARTAO' | 'TRANSFERENCIA'
  fechamento_parcelas_inst Int? // parcelas da instalação
  fechamento_data_1cob     DateTime? // data da 1ª cobrança da mensalidade
  fechamento_obs           String?   @db.Text
  fechamento_data          DateTime? // quando foi marcado como aceito
  fechamento_por           String? // user id de quem fechou

  // ─── Contrato ZapSign ──
  zapsign_doc_token       String? // token do documento no ZapSign
  zapsign_doc_status      String? // pending|signed|cancelled
  zapsign_signed_url      String?   @db.Text // URL para o cliente assinar
  zapsign_signed_file_url String?   @db.Text // URL do arquivo já assinado
  zapsign_enviado_em      DateTime?

  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  atividades       Atividade[]
  propostas        Proposta[]
  contrato         Contrato?
  indicacoes       Indicacao[]
  observacoes_lead LeadObservacao[]
  etiquetas_lead   LeadEtiquetaAplicada[]
  onboarding       LeadOnboarding?
  execucao         ExecucaoTecnica?

  // Exclusão lógica: lead sai de TODOS os resultados, fica só na auditoria/trilha.
  deleted_at      DateTime?
  deleted_by      String?
  motivo_exclusao String?   @db.Text

  @@index([status])
  @@index([deleted_at])
  @@index([etapa_comercial])
  @@index([status_atendimento])
  @@index([temperatura])
  @@index([etapa_funil])
  @@index([responsavel_id])
  @@index([created_at])
  @@index([vendedor_nome])
}

model LeadObservacao {
  id      String @id @default(cuid())
  lead_id String
  lead    Lead   @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  tipo                 String
  descricao            String    @db.Text
  proxima_acao         String?
  data_proximo_retorno DateTime?
  status_apos          String?

  // Rastreamento automático de mudanças
  coluna_anterior      String?
  coluna_nova          String?
  temperatura_anterior String?
  temperatura_nova     String?

  created_by      String
  created_by_name String?
  created_at      DateTime @default(now())

  @@index([lead_id])
  @@index([tipo])
  @@index([created_at])
}

model KanbanColuna {
  id         String   @id @default(cuid())
  chave      String   @unique
  nome       String
  cor        String   @default("#6b7280")
  ordem      Int      @default(99)
  ativa      Boolean  @default(true)
  fixa       Boolean  @default(false)
  quadro_id  String? // quadro ao qual a coluna pertence (null = Pipeline Comercial padrão)
  created_by String   @default("system")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ordem])
  @@index([ativa])
  @@index([quadro_id])
}

// Quadro comercial (kanban). O Pipeline Comercial é o quadro fixo padrão; é possível
// criar outros quadros independentes (ex.: Follow-up) com colunas e regras próprias.
model QuadroComercial {
  id        String  @id @default(cuid())
  nome      String
  descricao String? @db.Text
  tipo      String  @default("CUSTOM") // PIPELINE | FOLLOWUP | CUSTOM
  cor       String  @default("#417ABC")
  ordem     Int     @default(99)
  ativo     Boolean @default(true)
  fixo      Boolean @default(false) // Pipeline Comercial não pode ser excluído

  // Regra de entrada automática de leads no quadro
  regra_tipo     String  @default("NENHUMA") // NENHUMA | PARADOS_DIAS
  regra_dias     Int? // ex.: 40 (parado há +N dias sem mudar de etapa)
  coluna_entrada String? // chave da coluna onde o lead cai ao entrar
  // Colunas que "finalizam" o lead no quadro (ele não sai por inatividade)
  colunas_finais Json? // ex.: ["RECUPERADO","DESCARTADO"]
  cadencia_dias  Json? // ex.: [7,15,30,45] p/ alertas de toque

  created_by String   @default("system")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([ordem])
  @@index([ativo])
}

// Posição de um lead em um quadro NÃO-pipeline (no Pipeline a posição é o etapa_comercial).
model LeadQuadroPosicao {
  id               String    @id @default(cuid())
  lead_id          String
  quadro_id        String
  coluna_chave     String
  // Cadência de follow-up
  entrou_em        DateTime  @default(now())
  ultima_tentativa DateTime?
  proxima_acao_em  DateTime?
  tentativas       Int       @default(0)
  finalizado       Boolean   @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([lead_id, quadro_id])
  @@index([quadro_id])
  @@index([lead_id])
  @@index([proxima_acao_em])
}

model Etiqueta {
