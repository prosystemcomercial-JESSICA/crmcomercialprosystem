// ===== RELATÓRIO COMERCIAL MENSAL (o que vai para o CEO) =====
// 1 registro por mês/ano. Números calculáveis são preenchidos automaticamente
// pela rota agregadora; dados externos (marketing, ligações, churn detalhado)
// ficam editáveis. Salvo progressivamente (snapshot diário).
// Indicadores executivos do CEO preenchidos manualmente mês a mês (o que o CRM
// não calcula sozinho): CAC, caixa, NPS, marketing (custo/canais) e despesas do
// setor. 1 registro por ano-mês. A Diretora preenche; o painel do CEO consome.
model IndicadorMensalCEO {
  id   String @id @default(cuid())
  ano  Int
  mes  Int    // 1-12

  // Financeiro / direção
  caixa_disponivel    Float?   // saldo em caixa no fechamento do mês
  contas_a_receber    Float?   // a receber no mês
  inadimplencia       Float?   // valor inadimplente
  faturamento         Float?   // faturamento do mês
  lucro_liquido       Float?
  despesas_setor      Float?   // despesas do setor comercial no mês

  // Marketing (lançado no último dia do mês)
  marketing_investido Float?   // total investido em marketing/tráfego
  marketing_leads     Int?     // leads atribuídos a campanha (manual, complementa o auto)
  cac                 Float?   // custo de aquisição de cliente
  cpl                 Float?   // custo por lead

  // Satisfação
  nps                 Float?   // NPS consolidado do mês

  observacoes String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([ano, mes], name: "uq_indicador_ceo")
  @@index([ano])
}

model RelatorioComercial {
  id            String   @id @default(cuid())
  ano           Int
  mes           Int      // 1-12
  supervisor    String?  @default("Jessica Cardoso")

  // Resumo do mês (auto + editável)
  contratos_fechados   Int     @default(0)
  meta_contratos       Int     @default(15)
  instalacao_total     Float   @default(0)
  mrr_total            Float   @default(0)
  cancelamentos        Int     @default(0)
  mrr_perdido          Float   @default(0)

  // Pipeline geral
  propostas_total      Int     @default(0)
  propostas_negociacao Int     @default(0)
  propostas_fechadas   Int     @default(0)
  propostas_declinadas Int     @default(0)
  setup_potencial      Float   @default(0)
  mrr_potencial        Float   @default(0)

  // Blocos detalhados (listas) — JSON livre p/ não engessar
  por_vendedor   Json?    // [{nome, propostas, setup_potencial, mrr_potencial, em_negociacao, fechadas, participacao}]
  por_segmento   Json?    // [{segmento, propostas, setup_total, mrr_total, ticket_mrr, participacao}]
  contratos_lista Json?   // [{empresa, segmento, instalacao, mrr, origem}]
  atividade      Json?    // [{vendedor, ligacoes, qualificadas, tempo, conversao, insights}]
  marketing      Json?    // {investido, resultados, impressoes, campanhas:[], roi}
  cancelamentos_lista Json? // [{motivo, qtd}]
  resumo_executivo Json?  // [string]

  fechado       Boolean  @default(false) // mês consolidado (não recalcula mais)
  observacoes   String?  @db.Text

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@unique([ano, mes], name: "uq_relatorio_mes")
  @@index([ano])
}

// ===== PESQUISA DE SATISFAÇÃO (LP pública, enviada pelo técnico) =====
// Cliente responde por link aberto e se identifica digitando razão/fantasia.
// O sistema casa com o Cliente da base, anexa à ficha e marca crítico
// (nota < 3 ou não conhece os diferenciais) → abre caso de churn + risco.
model PesquisaSatisfacao {
  id                String   @id @default(cuid())

  // Identificação digitada pelo cliente na LP
  identificacao     String   // razão social ou nome fantasia que o cliente digitou
  respondente_nome  String?  // quem respondeu (opcional)

  // Vínculo automático ao Cliente da base (quando casa razão/fantasia)
  cliente_id        String?
  cliente_casado    Boolean  @default(false)

  // Avaliações (1-5 estrelas)
  // Legados (mantidos p/ dados antigos; novas respostas usam os campos abaixo):
  nota_suporte      Int      @default(0)
  nota_sistema      Int      @default(0)
  conhece_plano     Boolean  @default(false) // conhece os diferenciais do plano? (genérico)

  // Conhece os diferenciais/produtos (radar de upsell — reflete na ficha do cliente):
  conhece_plus       Boolean @default(false) // plano Plus
  conhece_dashboard  Boolean @default(false) // Dashboard
  conhece_mensageria Boolean @default(false) // serviço de mensageria de WhatsApp
  conhece_gerencial  Boolean @default(false) // Gerencial (monitoramento de notas fiscais)

  // Avaliação do atendimento técnico (formulário oficial):
  nota_atendimento  Int      @default(0) // nota para esse atendimento
  nota_eficiencia   Int      @default(0) // eficiência e rapidez na resolução
  nota_conhecimento Int      @default(0) // conhecimento do técnico
  nota_geral        Int      @default(0) // nota geral para a ProSystem (NPS)
  email             String?              // e-mail do respondente

  // Texto livre
  recado            String?  @db.Text     // recado/sugestão/elogio (técnico ou Prosystem)
  observacao        String?  @db.Text
  sugestoes         String?  @db.Text

  // Novos campos (formulário v2 — score 0-100)
  cargo_respondente String?  // dono|gerente|balconista|financeiro|outro
  resolucao         String?  // totalmente|parcialmente|nao_resolveu|nao_sei
  rapidez           String?  // muito_rapido|esperado|demorou_pouco|demorou_muito
  interesse_comercial String? // sim|talvez|nao  — quer conhecer ferramentas?
  whatsapp          String?  // contato WhatsApp do respondente

  // Score 0-100 calculado pelo backend conforme fórmula ponderada
  score             Int      @default(0)
  // Alertas especiais (palavras críticas no comentário, problema não resolvido etc.)
  alerta_especial   Boolean  @default(false)
  alerta_motivo     String?  // descrição resumida do alerta

  // Classificação automática
  critico           Boolean  @default(false) // nota < 3 OU não conhece o plano
  media             Float    @default(0)      // média das duas notas
  caso_churn_id     String?  // caso de churn aberto automaticamente (se crítico)

  ip_address        String?
  created_at        DateTime @default(now())

  @@index([cliente_id])
  @@index([critico])
  @@index([score])
  @@index([created_at])
}

// ===== CENTRO DE CUSTOS COMERCIAL =====
// Lançamentos financeiros do setor comercial: entradas (vendas, instalações,
// serviços, MRR) e saídas (salários, benefícios, marketing, comissões).
model LancamentoFinanceiro {
  id           String   @id @default(cuid())
  tipo         String   // ENTRADA | SAIDA
  categoria    String   // SALARIO|BENEFICIO|AJUDA_CUSTO|MARKETING|COMISSAO|OUTRO_CUSTO
                        // | MENSALIDADE|INSTALACAO|SERVICO|VENDA|OUTRA_ENTRADA
  descricao    String? @db.Text
  valor        Decimal  @db.Decimal(12, 2)
  recorrencia  String   @default("MENSAL") // MENSAL|ANUAL|PONTUAL|EXTRAORDINARIO
  // Competência (a que mês/ano o lançamento pertence — base dos filtros).
  competencia_ano  Int
  competencia_mes  Int     // 1-12
  data         DateTime @default(now())  // data do efetivo lançamento
  observacoes  String?  @db.Text
  // Vínculos opcionais (rastreabilidade)
  vendedor_id  String?
  cliente_id   String?
  // Origem automática (ex.: COMISSAO → Comissao.id). Null para lançamentos manuais.
  origem_tipo  String?
  origem_id    String?

  created_by   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([tipo])
  @@index([categoria])
  @@index([competencia_ano, competencia_mes])
  @@index([recorrencia])
  @@index([origem_tipo, origem_id])
}

// ===== WHATSAPP (Inbox multi-instância via Evolution API) =====
// Cada usuário conecta a própria instância (QR Code). Escopo por dono_id:
// vendedor vê só as suas conversas; gestão (podeVerTudo) vê todas.

model WhatsappInstancia {
  id             String    @id @default(cuid())
  // Nome único da instância na Evolution API (ex.: "crm-<userId>").
  instancia_nome String    @unique
  apelido        String? // nome amigável (ex.: "Comercial", "Suporte")
  dono_id        String // UsuarioCRM.id que conectou (escopo por dono)
  dono_nome      String?
  numero         String? // número conectado (preenchido após parear)
  status         String    @default("DESCONECTADO") // DESCONECTADO|CONECTANDO|CONECTADO
  qr_code        String?   @db.Text // último QR (base64) enquanto conecta
  conectado_em   DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  conversas WhatsappConversa[]

  @@index([dono_id])
  @@index([status])
}

model WhatsappConversa {
  id          String            @id @default(cuid())
  instanciaId String
  instancia   WhatsappInstancia @relation(fields: [instanciaId], references: [id], onDelete: Cascade)

  dono_id        String // herdado da instância — facilita o escopo nas queries
  contato_numero String // E.164 sem máscara (ex.: 5527999999999)
  contato_nome   String?
  lead_id        String? // vínculo opcional ao Lead do funil
  cliente_id     String? // vínculo opcional ao Cliente da base (contato que já é cliente)

  ultima_mensagem String?   @db.Text
  ultima_em       DateTime?
  nao_lidas       Int       @default(0)

  // Chatbot de qualificação (fluxo guiado p/ número novo)
  bot_estado      String?   // null|SAUDACAO|AGUARDA_CLIENTE|AGUARDA_SEGMENTO|AGUARDA_NOME|CONCLUIDO
  bot_ativo       Boolean   @default(false) // o bot está conduzindo esta conversa?

  // Etiqueta de organização (ex.: Padaria, Farmácia, Varejo, Cliente, Lead, Parceiro)
  etiqueta        String?
  etiqueta_cor    String?   @default("#6b7280")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  mensagens WhatsappMensagem[]

  @@unique([instanciaId, contato_numero], name: "uq_conversa")
  @@index([dono_id])
  @@index([lead_id])
  @@index([ultima_em])
}

model WhatsappMensagem {
  id         String           @id @default(cuid())
  conversaId String
  conversa   WhatsappConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  externo_id  String? // id da mensagem na Evolution (idempotência)
  direcao     String // ENTRADA|SAIDA
  tipo        String  @default("TEXTO") // TEXTO|IMAGEM|AUDIO|DOCUMENTO|OUTRO
  conteudo    String  @db.Text
  midia_url   String? @db.Text
  status      String  @default("ENVIADA") // ENVIADA|ENTREGUE|LIDA|FALHA (saída)
  enviada_por String? // UsuarioCRM.id (quando SAIDA pelo CRM)

  created_at DateTime @default(now())

  @@unique([externo_id], name: "uq_msg_externa")
  @@index([conversaId])
  @@index([direcao])
}

// ─── BASE DE CONHECIMENTO TÉCNICA ─────────────────────────────────────────────

model KbCategoria {
  id          String   @id @default(cuid())
  nome        String
  descricao   String? @db.Text
  icone       String?  // nome do ícone lucide-react
  ordem       Int      @default(0)
  parent_id   String?
  parent      KbCategoria?  @relation("KbCatFilhas", fields: [parent_id], references: [id])
  filhas      KbCategoria[] @relation("KbCatFilhas")
  artigos     KbArtigo[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([parent_id])
}

model KbArtigo {
  id           String      @id @default(cuid())
  titulo       String
  conteudo     String      @db.LongText
  resumo       String?     @db.Text
  categoria_id String?
  categoria    KbCategoria? @relation(fields: [categoria_id], references: [id])
  autor_id     String?     // UsuarioCRM.id
  autor_nome   String?
  status       String      @default("RASCUNHO") // RASCUNHO | PUBLICADO | ARQUIVADO
  visibilidade String      @default("INTERNO")  // INTERNO | PUBLICO (portal cliente)
  tags         String?     // JSON array de strings
  views        Int         @default(0)
  util_sim     Int         @default(0) // feedback positivo
  util_nao     Int         @default(0) // feedback negativo
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@index([categoria_id])
  @@index([status])
  @@index([visibilidade])
}

// ─── CSAT — PESQUISA DE SATISFAÇÃO PÓS-TICKET / PÓS-IMPLANTAÇÃO ───────────────

model CsatSurvey {
  id              String      @id @default(cuid())
  tipo            String      // TICKET | IMPLANTACAO
  referencia_id   String      // id do ticket ou implantação
  cliente_id      String?
  cliente_nome    String?
  token           String      @unique @default(cuid()) // magic link token
  status          String      @default("PENDENTE") // PENDENTE | RESPONDIDO | EXPIRADO
  nota            Int?        // 1-5
  comentario      String?     @db.Text
  respondido_at   DateTime?
  expira_at       DateTime    // geralmente 7 dias após criação
  criado_por      String?     // UsuarioCRM.id que fechou o ticket
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  @@index([referencia_id])
  @@index([token])
  @@index([status])
  @@index([tipo])
}
