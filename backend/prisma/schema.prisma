  campo_alterado String?
  valor_anterior String? @db.Text
  valor_novo     String? @db.Text
  motivo         String? @db.Text
  observacao     String? @db.Text

  feito_por_id   String?
  feito_por_nome String?
  feito_por_role String?

  created_at DateTime @default(now())

  @@index([proposta_id])
  @@index([created_at])
