// ===== VENDAS ADICIONAIS (Cross-sell base de clientes) =====

model Parceiro {
  id                      String  @id @default(cuid())
  nome                    String
  categoria               String // FISCAL | TEF | TRIBUTARIO | COMUNICACAO | UPGRADE | OUTRO
  pitch                   String? @db.Text
  comissao_valor          Float   @default(50)
  tabela_valores          String? @db.Text
  valor_referencia        Float? // valor fixo para cálculo de comissão da supervisão (ex: R$100 fiscal, R$350 upgrade)
  comissao_supervisao_pct Float   @default(5) // percentual da supervisão (5%)
  ativo                   Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vendas VendaAdicional[]

  @@index([categoria])
  @@index([ativo])
}

model VendaAdicional {
  id         String  @id @default(cuid())
  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  parceiro_id String?
  parceiro    Parceiro? @relation(fields: [parceiro_id], references: [id])

  vendedor_id   String
  vendedor_nome String? // nome do vendedor que fez a venda (exibição)
  supervisao_id String? // quem registrou (supervisor que faz o cadastro)

  tipo_negocio     String  @default("INDICACAO") // INDICACAO | REVENDA
  valor_venda      Float?
  // Acréscimo mensal negociado com o cliente (ex.: Arquivo Fiscal). Soma na
  // mensalidade total do cliente quando a venda é CONFIRMADA.
  acrescimo_mensal Float?
  plano_anterior   String?
  plano_novo       String?
  // Mensalidade do cliente ANTES do upgrade (snapshot no momento da venda) e
  // a NOVA mensalidade (anterior + acréscimo). Expostas no fluxo de upgrade.
  mensalidade_anterior Float?
  mensalidade_nova     Float?
  // Forma de pagamento do setup/valor único do upgrade (aditivo):
  // setup_forma: ENTRADA_PARCELAS (entrada + parcelas) | PARCELADO (parcelas direto)
  setup_forma        String?  @default("PARCELADO")
  setup_entrada      Float?   // valor da entrada (quando ENTRADA_PARCELAS)
  setup_parcelas     Int?     // nº de parcelas do saldo
  setup_primeiro_venc DateTime? // vencimento da 1ª parcela (demais = mensais sucessivas)

  comissao_valor            Float     @default(50)
  comissao_paga             Boolean   @default(false)
  comissao_paga_em          DateTime?
  comissao_supervisao_valor Float? // calculado automaticamente ao confirmar

  // ── Comunicação multi-loja (aditivo) ───────────────────────────────────────
  // Vendas de COMUNICAÇÃO envolvem várias lojas (cada uma é um Cliente da base).
  // O acréscimo_mensal é POR LOJA (total = acrescimo_mensal * nº lojas). O setup
  // é cobrado de UMA loja específica. A venda fica salva na ficha de todas.
  lojas_ids        Json?     // string[] de cliente_id das lojas que vão se comunicar
  lojas_nomes      Json?     // string[] (snapshot dos nomes p/ exibição)
  // Detalhe por loja: [{ cliente_id, nome, codigo, acrescimo }]. Cada loja tem o
  // SEU acréscimo individual (pode ser 0 se já comunica e está sendo só associada).
  lojas_detalhe    Json?
  setup_loja_id    String?   // cliente_id da loja onde o setup será cobrado
  // ── Datas do ciclo (aditivo) ────────────────────────────────────────────────
  data_venda             DateTime? // data inicial da venda
  data_inicio_comunicacao DateTime? // quando a comunicação começa a funcionar
  primeiro_vencimento    DateTime? // 1º vencimento (base p/ comissão: mês seguinte)
  data_indicacao         DateTime? // (demais parceiros) data da indicação
  data_confirmacao       DateTime? // (demais parceiros) data da confirmação
  data_fechamento        DateTime? // data em que o negócio foi efetivamente fechado

  status String @default("PENDENTE") // PENDENTE | CONFIRMADA | PAGA | CANCELADO

  observacoes String? @db.Text

  origem_oportunidade_id String? // OportunidadeAtivo que gerou esta venda (módulo Ativos)

  created_by String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cliente_id])
  @@index([parceiro_id])
  @@index([vendedor_id])
  @@index([status])
  @@index([created_at])
}

// ===== HEALTH SCORE =====

model HealthScore {
  id         String  @id @default(cuid())
  cliente_id String  @unique
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  score   Float // 0-100
  nivel   String @default("ATENCAO") // CRITICO|RISCO|ATENCAO|SAUDAVEL|EXCELENTE
  fatores Json // {tickets_abertos, dias_sem_contato, nps_score, contratos_ativos, ...}

  calculado_at DateTime @default(now())
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([nivel])
  @@index([score])
}

// Snapshot histórico do HealthScore — HealthScore só guarda o valor ATUAL
// (sobrescrito a cada recálculo). Esta tabela acumula um ponto por recálculo
// para permitir calcular TENDÊNCIA (piorando/melhorando) ao longo do tempo.
model HealthScoreSnapshot {
  id          String   @id @default(cuid())
  cliente_id  String
  score       Float
  nivel       String
  mrr_momento Float? // mensalidade_base do cliente no momento do snapshot
  created_at  DateTime @default(now())

  @@index([cliente_id, created_at])
}

// ===== MÓDULO ATIVOS (CS comercial feito pelos vendedores) =====
// A supervisão designa um GRUPO TÉCNICO a um vendedor → CampanhaAtivo. A fila de
// clientes ATIVOS daquele grupo vira ContatoAtivo (cards de kanban). O vendedor
// liga, aplica o questionário, mede a saúde, abre caso (churn) se há problema e
// registra oportunidades de venda. Tudo reflete na ficha (EventoCliente) e no
// HealthScore. Campanha CONTÍNUA (sem mês fixo).
model CampanhaAtivo {
  id            String  @id @default(cuid())
  grupo_tecnico String  // ex.: "Grupo 1 - João Victor"
  vendedor_id   String  // vendedor designado (responsável pela fila)
  vendedor_nome String?
  criada_por    String  // supervisão que designou
  meta_cobertura_pct Int     @default(100) // meta de % da fila a contatar
  status        String  @default("ATIVA")  // ATIVA | CONCLUIDA | CANCELADA
  observacoes   String? @db.Text

  total_fila    Int     @default(0) // nº de clientes puxados p/ a fila na criação

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  contatos ContatoAtivo[]

  @@index([vendedor_id])
  @@index([grupo_tecnico])
  @@index([status])
}

model ContatoAtivo {
  id          String        @id @default(cuid())
  campanha_id String
  campanha    CampanhaAtivo @relation(fields: [campanha_id], references: [id], onDelete: Cascade)

  cliente_id   String  // vínculo à base (sem relação reversa p/ não tocar no model Cliente)
  cliente_nome String?
  cliente_codigo String?
  vendedor_id  String

  // Kanban: A_CONTATAR → EM_CONTATO → CONCLUIDO | SEM_SUCESSO
  etapa       String  @default("A_CONTATAR")
  tentativas  Int     @default(0)
  contatado_em DateTime?

  // ── Controle da supervisão ──
  oculto       Boolean @default(false) // supervisão oculta da fila do vendedor (não tratar)
  oculto_motivo String? @db.Text
  etiqueta     String?                 // ex.: "Cliente crítico", "Não contatar"
  etiqueta_cor String?  @default("#dc2626")

  // ── Questionário (sim/não por item + nota geral + texto) ──
  usa_sistema_ok       Boolean? // usa bem o sistema/ferramentas?
  suporte_ok           Boolean? // satisfeito com o atendimento do suporte?
  tecnico_ok           Boolean? // satisfeito com o técnico que atende?
  conhece_novas_ferr   Boolean? // conhece as novas ferramentas?
  plus_apresentado     Boolean? // o plano Plus foi apresentado?
  nota_prosystem       Int?     // nota geral 1-5 p/ o sistema Prosystem
  sugestoes            String?  @db.Text

  // ── Saúde percebida neste contato (alimenta o HealthScore) ──
  saude               String?  // EXCELENTE | SAUDAVEL | ATENCAO | RISCO | CRITICO
  tem_problema        Boolean  @default(false)
  problema_descricao  String?  @db.Text
  caso_churn_id       String?  // caso aberto a partir deste contato (se houver)

  // ── Oportunidade de venda gerada a partir do contato ──
  gerou_venda    Boolean @default(false)
  tipo_venda     String? // UPGRADE | INDICACAO | FISCAL | PAC | TEF | COMUNICACAO | OUTRO
  venda_ref_id   String? // id da VendaAdicional/Proposta gerada (rastreio)
  venda_obs      String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([campanha_id, cliente_id], name: "uq_contato_ativo")
  @@index([campanha_id])
  @@index([vendedor_id])
  @@index([etapa])
  @@index([cliente_id])
}

// Oportunidades de venda geradas a partir do módulo Ativos.
// Uma por produto/parceiro por cliente, múltiplas permitidas.
// Fica em NEGOCIACAO até o vendedor confirmar o fechamento.
// Ao confirmar, cria a VendaAdicional real e muda para CONFIRMADA.
model OportunidadeAtivo {
  id           String  @id @default(cuid())
  contato_id   String  // ContatoAtivo (card kanban)
  cliente_id   String
  vendedor_id  String
  parceiro_id  String?
  parceiro_nome String?
  categoria    String? // FISCAL | TEF | TRIBUTARIO | COMUNICACAO | UPGRADE | OUTRO

  status       String  @default("NEGOCIACAO") // NEGOCIACAO | CONFIRMADA | CANCELADA
  valor_venda  Float?
  acrescimo_mensal Float?
  observacao   String? @db.Text

  venda_adicional_id String? // VendaAdicional criada ao confirmar

  criado_por   String?
  confirmado_por String?
  confirmado_em DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([contato_id])
  @@index([cliente_id])
  @@index([vendedor_id])
  @@index([status])
}

// ===== UTILITARIOS =====

model Credito {
  id         String  @id @default(cuid())
  cliente_id String
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  valor    Float
  validade DateTime
  motivo   String? @db.Text

