  utilizado_em DateTime?

  @@index([cliente_id])
  @@index([validade])
}

// ===== CONTRATOS COMERCIAIS (fluxo Proposta → Contrato → ZapSign) =====

model ContratoComercial {
  id String @id @default(cuid())

  cliente_id String? // cadastro de Cliente gerado a partir deste contrato (rastreabilidade)

  // Número sequencial
  numero_contrato String @unique // "33/2026"
  sequencia       Int
  ano             Int

  // Vínculo com proposta
  proposta_comercial_id String? @unique

  // Empresa contratante
  razao_social    String
  nome_fantasia   String?
  cnpj            String?
  endereco        String?
  numero_endereco String?
  bairro          String?
  cidade          String?
  estado          String?
  cep             String?

  // Representante legal
  representante_nome     String?
  representante_cpf      String?
  representante_email    String?
  representante_telefone String?
  representante_cargo    String?

  // Plano e mensalidade
  plano_contratado String?
  software_nome    String?
  software_versao  String?
  mensalidade      Float?
  dia_vencimento   Int?

  // Setup / instalação
  valor_setup_total       Float?
  valor_setup_entrada     Float?
  setup_parcelas          Int?
  valor_setup_parcela     Float?
  setup_a_vista           Boolean @default(false)
  setup_condicao_especial String? @db.Text

  // Tipo do contrato p/ não confundir TROCA DE CNPJ (serviço) com cliente NOVO.
  tipo_servico      String? @default("NOVO") // NOVO | TROCA_CNPJ

  // Equipe comercial
  vendedor_id       String? // p/ vincular comissão e meta ao vendedor
  vendedor_nome     String?
  supervisor_nome   String?
  campanha          String?
  condicao_especial String? @db.Text
  data_contrato     DateTime @default(now())

  // Comissão do vendedor (15% sobre o setup/instalação, calculada na assinatura)
  comissao_vendedor_pct   Float? @default(15)
  comissao_vendedor_valor Float?

  // Recuo / distrato (cliente assinou e desistiu) — sai da meta e estorna comissão
  recuado_at   DateTime?
  recuo_motivo String? @db.Text

  // Modelo ZapSign usado
  modelo_contrato        String? // "Pro" | "Plus" | "Farma Pro" | etc
  zapsign_template_token String? // token do modelo no ZapSign

  // Kanban status
  status String @default("A_GERAR")
  // A_GERAR | GERADO | ENVIADO_ASSINATURA | AGUARDANDO_ASSINATURA | ASSINADO | PENDENTE_CORRECAO | CANCELADO | RECUADO

  // ZapSign campos de rastreamento
  zapsign_doc_token       String?
  zapsign_signer_token    String?
  zapsign_signing_url     String? @db.Text
  zapsign_signed_file_url String? @db.Text
  zapsign_status          String?
  gerado_at               DateTime?
  sent_to_sign_at         DateTime?
  signed_at               DateTime?

  created_by String   @default("system")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([status])
  @@index([created_at])
  @@index([numero_contrato])
  @@index([proposta_comercial_id])
}

model ContratoSequencia {
  id         String   @id @default(cuid())
  ano        Int      @unique
  ultima_seq Int      @default(0)
  updated_at DateTime @updatedAt
}

model ConfiguracaoIntegracao {
  id         String   @id @default(cuid())
  chave      String   @unique
  valor      String   @db.Text
  descricao  String? @db.Text
  updated_at DateTime @updatedAt
  updated_by String?  @default("system")
}

// ===== TABELAS GERENCIADAS VIA SQL RAW (mapeadas no schema para o db push NÃO dropar) =====
// IMPORTANTE: estes modelos existem para que `prisma db push` reconheça as tabelas
// e NUNCA as remova. A criação/seed ainda é feita via CREATE TABLE IF NOT EXISTS nas rotas.

model UsuarioCRM {
