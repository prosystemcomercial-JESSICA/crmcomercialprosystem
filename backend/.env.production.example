# ============================================================
# VARIÁVEIS DE PRODUÇÃO — Railway
# Configure estas variáveis no painel do Railway
# ============================================================

# Banco de dados (Supabase)
# Obter em: Supabase > Settings > Database > Connection string > URI
# IMPORTANTE: adicione ?pgbouncer=true&connection_limit=1 no final
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Servidor
FASTIFY_PORT=3001
LOG_LEVEL=info
NODE_ENV=production

# Frontend — URL do Vercel (pode ser múltiplas separadas por vírgula)
# Ex: https://crm-prosystem.vercel.app,https://crm.prosystemnet.com.br
FRONTEND_URL=https://crm-prosystem.vercel.app

# JWT — Use senhas FORTES em produção (mínimo 64 chars)
JWT_SECRET=GERE-UMA-SENHA-FORTE-AQUI-MIN-64-CHARS
JWT_REFRESH_SECRET=GERE-OUTRA-SENHA-FORTE-AQUI-MIN-64-CHARS

# Google Calendar OAuth2
GOOGLE_CLIENT_ID=SEU-GOOGLE-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU-GOOGLE-CLIENT-SECRET
GOOGLE_REDIRECT_URI=https://SEU-BACKEND-RAILWAY.up.railway.app/agenda/google/callback

# ZapSign — Assinatura Eletrônica
ZAPSIGN_API_TOKEN=SEU-ZAPSIGN-API-TOKEN
ZAPSIGN_ORG_ID=SEU-ZAPSIGN-ORG-ID
ZAPSIGN_ENVIRONMENT=production
ZAPSIGN_WEBHOOK_SECRET=

# E-mail SMTP
SMTP_HOST=mail.prosystemnet.com.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jessica@prosystemnet.com.br
SMTP_PASS=SUA-SENHA-SMTP
SMTP_FROM_NAME=ProSystem Sistemas
SMTP_FROM_EMAIL=jessica@prosystemnet.com.br
