{
  "name": "portal-implantacao-backend",
  "version": "1.0.0",
  "description": "Portal de Implantação & Onboarding Prosystem — backend (Fastify + Prisma)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate",
    "start": "prisma migrate deploy || prisma db push --skip-generate; tsx src/server.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^8.4.2",
    "@prisma/client": "^5.22.0",
    "fastify": "^4.25.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "typescript": "^5.3.3"
  }
}
