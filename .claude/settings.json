{
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Edit(~/.claude/skills/expxagents/**)",
      "PowerShell(gh auth switch --user prosystemcomercial-JESSICA)",
      "PowerShell(git push origin main)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/handoff-recente.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
